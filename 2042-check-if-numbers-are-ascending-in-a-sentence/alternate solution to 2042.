class Solution:
    def areNumbersAscending(self, s: str) -> bool:
        l=0
        k=""
        for i in s:
            if 48<=ord(i)<=57:
                k+=i
            elif k!="" and i==" ":
                if l<int(k):
                    l=int(k)
                    print(l)
                else:
                    return False
                k=""
            else:
                k=""
        if k!="":
                if l<int(k):
                    l=int(k)
                else:
                    return False
        return True
